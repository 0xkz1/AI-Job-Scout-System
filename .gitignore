# Output — contains personal CVs, cover letters, match reports (PII)
output/
10_output/*
static/pdfs/

# …except the company-name casing registry. It is public company names only, no
# PII, and it is what pins one spelling per company in make_safe_name() — losing
# it brings back the filename case collisions that broke Syncthing against the
# case-insensitive Mac volume. Replication is not history: a bad edit propagates.
# (The rule above is 10_output/* rather than 10_output/ because git cannot
# re-include a file whose parent directory is itself excluded.)
!10_output/_company_casing.json

# The same documents by name, wherever they land. A generator run from the
# wrong cwd (or a --dir left at its default) drops them in the repo root,
# where the directory rules above do not reach — and they are exactly the
# PII those rules exist to keep out of history.
*_CV.md
*_CL.md
*_review.md
*_email.md

# Staging — contains raw scraped job data (large + ephemeral)
00_saved/

# Browser session state / cookies (credentials)
linkedin_cookies.state
*.state

# Misc output / logs
output.txt


# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/

# Environment / secrets
.env
*.env
# Both patterns above only match a name ENDING in .env, so every timestamped
# backup this repo's own scripts leave behind (.env.bak_20260818_072116) sat
# untracked but unignored — one `git add -A` from committing 24 Mistral keys,
# plus the groq, zai and nvidia pools, in plaintext.
.env.*
!.env.example
cookies/
.browser_context/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Streamlit
streamlit.log

# Playwright
playwright-report/
test-results/

# Debug output
debug_*.py

# Pre-refactor snapshots (working copies, not history)
.backup/

# Generated documents that land at the repo root instead of 10_output/.
# Sweep them into 10_output/.stray_from_root_<date>/ — that path is already
# ignored by the 10_output/* rule above.
/*.pdf
