# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Contact details written into every generated CV, cover letter and outreach
# email. They live here rather than in tracked source because this repository
# is public: a CV hands an address and a phone number to the person it is sent
# to, which is the point, and publishing the same values to everyone forever is
# not the same act. With none of these set the generators emit visible
# placeholders (CANDIDATE_EMAIL and so on), so an unconfigured checkout
# produces an obviously unfinished document rather than a quietly wrong one.
CV_NAME=Your Name
CV_NAME_JA=
CV_LOCATION=City, Country
CV_EMAIL=you@example.com
# National form, for a CV answering a posting in your own country.
CV_PHONE=00000 000000
# International form. The Japanese CV uses this one — a reader dialling it is
# not in the UK.
CV_PHONE_INTL=+00 0000 000000
CV_PORTFOLIO=https://example.com/
CV_GITHUB=https://github.com/you
CV_LINKEDIN=https://www.linkedin.com/in/you

# Gmail account used to build outreach drafts, and a 16-character app password
# from myaccount.google.com/apppasswords. Not your ordinary account password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# LLM routing. litellm-gateway fronts the whole key pool and holds its own
# cooldown table, so it leads; the direct providers behind it are the path for
# when that gateway is down. See llm_client.
ANALYSIS_PROVIDER=litellm-gateway
FALLBACK_PROVIDERS=
LITELLM_GATEWAY_URL=http://localhost:4001
LITELLM_GATEWAY_API_KEY=
